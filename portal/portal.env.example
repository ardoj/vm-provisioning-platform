# Copy to portal.env (git-ignored) and fill in. Read by docker-entrypoint.sh.
# Comments must be on their own line: env files do not support inline comments.

# ── GitLab: the deployments repo the portal commits server folders into ──
GITLAB_URL=https://gitlab.example.internal
PROJECT_ID=123
# Maintainer token with api + write_repository. Injected server-side by the
# nginx /glproxy/ location — it is NOT sent to the browser.
GITLAB_TOKEN=glpat-REPLACE-ME
REPO_BRANCH=main
SERVERS_DIR=servers
REPO_PATH=infra/vm-deploy

# ── Module registry + versions pinned into generated main.tf ──
MODULE_REGISTRY=gitlab.example.internal/infra
# vsphere-clone-vm
MODULE_VERSION=1.0.0
# proxmox-clone-vm (required for Proxmox)
MODULE_VERSION_PVE=1.0.0

# ── vSphere inventory for the form's pickers (use a READ-ONLY account: ──
# ── these two are visible to the browser, see README "Security")      ──
DC1_VCENTER=vcenter-dc1.example.internal
DC2_VCENTER=vcenter-dc2.example.internal
VCENTER_USER=readonly@vsphere.local
VCENTER_PASS=REPLACE-ME

# ── Proxmox clusters: "key=host:port,..."; first is the default ──
PVE_ENDPOINTS=test=pve-test01.example.internal:8006,prod=pve-prod01.example.internal:8006
# Read-only inventory token per cluster (Sys.Audit, VM.Audit, Datastore.Audit,
# SDN.Audit). Injected server-side by nginx; empty = static defaults only.
PVE_API_TOKEN_test=readonly@pve!portal=REPLACE-ME
PVE_API_TOKEN_prod=readonly@pve!portal=REPLACE-ME

# ── Optional: directory serving <user>.pub SSH keys for the user picker ──
SSH_KEY_DIR_URL=http://files.example.internal/ssh
